{
    "permissions": {
        "allow": [
            "Bash(git diff:*)",
            "Read(modules/**)",
            "Bash(ls:*)",
            "Bash(sed:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(cat:*)",
            "Bash(grep:*)",
            "Bash(npm run start:*)",
            "Bash(npm run build:*)",
            "Bash(npm run test:*)",
            "Bash(npm run test:unit:*)",
            "Bash(npm run test:api:*)",
            "Bash(npm run test:e2e:*)",
            "Bash(npm run format:*)"
        ],
        "ask": [
            "Bash(git commit:*)"    
        ],
        "deny": [
            "Bash(git push:*)",
            "Read(.env)",
            "WebFetch"
        ]
    },
    "hooks": {
        "PreToolUse": [{
            "matcher": "Bash",
            "hooks": [{
                "type": "command",
                "command":
                    "python3 .claude/hooks/block_git_push.py"
            }, 
            {
                "type": "command",
                "command":
                    "python3 .claude/hooks/format_on_git_commit.py",
                "statusMessage": "Prettier перед git commit..."
            }]
        }]
    }
}