# Конфигурация сервера SIP-автестов: копия этого файла в .env
# (cp .env.example .env) с реальными номерами/паролями и адресами стенда.
# Читается ТОЛЬКО server/config.ts (plan_2.md §1.3); валидация полей — там же.

# HTTP-порт веб-интерфейса и REST API.
SERVER_PORT=3000

# Живая АТС (классический SIP); Asterisk запрещён (plan_2.md §1).
PBX_HOST=192.168.80.157
PBX_PORT=5060

# Транспорт SIP: udp или tcp (режим один на весь сервер).
SIP_PROTOCOL=udp

# WS-мост: адрес ЭТОЙ машины, видимый станции (не 127.0.0.1 — иначе станция
# не достанет до Contact, см. «Грабли» в CLAUDE.md), и порт WS-сервера.
BRIDGE_HOST=192.168.80.159
BRIDGE_PORT=8090

# Виртуальные абоненты: номер и Digest-пароль; абонент 3 (3203) — только цель вызова
# в цепочке 9404→3203→52, НЕ регистрируется.
SIP_NUMBER_1=9404
SIP_PASS_1=123
SIP_NUMBER_2=52
SIP_PASS_2=321
SIP_NUMBER_3=3203
SIP_PASS_3=123

# Станция-эмулятор (plan_4.md п.2), необязательные поля — дефолты те же:
# адрес этой машины, SIP-порт (0 — эфемерный, без root; 5060 — см. setcap
# в README), транспорт udp|tcp|both.
STATION_HOST=192.168.80.159
STATION_PORT=5060
STATION_PROTO=both
